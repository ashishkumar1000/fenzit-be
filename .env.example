NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=your-bucket-name

# Internal webhook secret (shared with Cloudflare Worker)
# Generate with: openssl rand -hex 32
WORKER_WEBHOOK_SECRET=your-worker-webhook-secret-min-32-chars

# Google Places API (live provider — billed per request; MockPlacesProvider is
# used instead only under NODE_ENV=test)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Optional places rate-limit budgets (defaults 60s window; 30 autosuggest /
# 10 resolve / 10 reverse) — tune per environment without a redeploy
# PLACES_AUTOSUGGEST_RATE_LIMIT_WINDOW_SECONDS=60
# PLACES_AUTOSUGGEST_RATE_LIMIT_MAX=30
# PLACES_RESOLVE_RATE_LIMIT_WINDOW_SECONDS=60
# PLACES_RESOLVE_RATE_LIMIT_MAX=10
# PLACES_REVERSE_RATE_LIMIT_WINDOW_SECONDS=60
# PLACES_REVERSE_RATE_LIMIT_MAX=10

# Grafana Cloud OTLP metrics (src/telemetry/) — copy the endpoint and headers
# lines from the Grafana Cloud portal's OpenTelemetry tile. Telemetry exports
# ONLY when NODE_ENV=production and the endpoint is set — local dev, tests
# and CI never export (OTEL_SDK_DISABLED=true also turns it off).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
# Optional export cadence in ms (default 30000). Values outside 1s–1h fall
# back to the default.
# OTEL_EXPORT_INTERVAL_MS=30000
