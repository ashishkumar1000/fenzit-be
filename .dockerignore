# Keep the build context small — only package manifests, tsconfig, nest-cli
# and src are actually copied into the image.
.git
.gitignore
node_modules
dist
coverage
test
docs
scripts
supabase
cloudflare-worker
*.md
.env*
Dockerfile
render.yaml
# Render copies Secret Files into the build context root. The Dockerfile only
# copies named files, but keep the FCM sender key out of the context anyway.
fenzit-fcm-sender.json